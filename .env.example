# ==============================================================================
# AGENTISE MEGA CRM - SELF-HOSTED / WHITE-LABEL EDITION
# Arquivo de Configuração de Ambiente (.env)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para ".env" na raiz do projeto:
#    cp .env.example .env (Linux/Mac) ou copy .env.example .env (Windows)
# 2. Preencha as chaves e credenciais da sua própria empresa.
# 3. Nenhuma chave do desenvolvedor é necessária: o sistema é 100% autônomo (BYOK).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR E AMBIENTE
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_NAME="Agentise Mega CRM"
# Chave secreta aleatória para assinatura dos tokens JWT da sua equipe:
SECRET_KEY="sua_chave_secreta_super_segura_aqui_troque_para_producao"

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL / Supabase / Neon / Docker)
# ------------------------------------------------------------------------------
# Deixe em branco para usar o motor de alta performance nativo JsonDB (zero dependências).
# Para usar PostgreSQL ou Supabase, informe a connection string:
# DATABASE_URL="postgresql://usuario:senha@seu-host:5432/nomedobanco?sslmode=require"
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. CHAVES DE INTELIGÊNCIA ARTIFICIAL (BYOK - BRING YOUR OWN KEY)
# ------------------------------------------------------------------------------
# O sistema funciona mesmo sem chaves de IA utilizando o motor Heurístico Nativo.
# Para ativar LLMs de ponta nos módulos Copiloto, RecuperaIA e Analista:

# OpenAI (GPT-4o Mini / GPT-4o) - Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (Gemini 1.5 Flash - Gratuito/Econômico) - Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet) - Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama Local (Opcional - caso queira rodar modelos locais como Llama 3 / Mistral)
OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------------------------
# 4. PAGAMENTO PIX OFICIAL DO BANCO CENTRAL DO BRASIL (SEM INTERMEDIÁRIOS)
# ------------------------------------------------------------------------------
# O dinheiro das vendas cai DIRETAMENTE na conta bancária da sua empresa:
# Chave PIX da sua empresa (E-mail, CPF/CNPJ, Telefone com +55 ou Chave Aleatória):
PIX_CHAVE="suaempresa@pix.com.br"

# Nome do titular da conta que receberá os pagamentos (Máx 25 caracteres, maiúsculas):
PIX_BENEFICIARIO="SUA EMPRESA LTDA"

# Cidade do titular da conta bancária (Máx 15 caracteres, maiúsculas):
PIX_CIDADE="SAO PAULO"

# Secret opcional para conciliação automática de Webhook do PIX:
PIX_WEBHOOK_SECRET="segredo_webhook_pix_gerado_pelo_seu_banco"

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API OFICIAL (META FOR DEVELOPERS) - OPCIONAL
# ------------------------------------------------------------------------------
# Para envio e recebimento de mensagens diretamente pela API oficial do WhatsApp:
# Obtenha em: https://developers.facebook.com/apps/
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=

# ------------------------------------------------------------------------------
# 6. GOVERNANÇA INTERNA DE CRÉDITOS DE IA
# ------------------------------------------------------------------------------
# Como as chamadas vão para as suas próprias chaves de IA (BYOK), defina aqui
# o teto mensal de créditos que sua equipe pode gastar para evitar abusos internos:
DEFAULT_MONTHLY_AI_CREDITS=50000
